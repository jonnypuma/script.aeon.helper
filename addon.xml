<?xml version="1.0" encoding="UTF-8"?>
<addon id="script.aeon.helper" name="Aeon Fuse Helper" version="0.3.66" provider-name="Aeon Fuse">
	<requires>
		<import addon="xbmc.python" version="3.0.1"/>
		<!-- optional: the Planner and online lists read TMDb Helper; artwork colours come from KarmaMole's helper -->
		<import addon="plugin.video.themoviedb.helper" optional="true"/>
		<import addon="script.karmamole.helper" optional="true"/>
	</requires>
	<extension point="xbmc.service" library="service.py"/>
	<extension point="xbmc.python.script" library="swap.py"/>
	<!-- lists for the artist information page; provides nothing, so it is not listed among the music add-ons -->
	<extension point="xbmc.python.pluginsource" library="plugin.py">
		<provides></provides>
	</extension>
	<!-- context menu items, in the order and with the switches of Aeon Fuse's Skin settings > Context menu.
	     Generated by resources/lib/ctxmenu.addon_items (tests/test_ctxmenu.py checks it): every item at every place. -->
	<extension point="kodi.context.item">
		<menu id="kodi.core.main">
			<item library="context.py" args="refresh,1">
				<label>32000</label>
				<visible>[String.IsEqual(Skin.String(aeon.ctx.pos1),refresh) | String.IsEmpty(Skin.String(aeon.ctx.pos1))] + Skin.HasSetting(aeon.ctx.refresh) + !ListItem.IsParentFolder + Integer.IsGreater(ListItem.DBID,0) + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,musicvideo)]</visible>
			</item>
			<item library="context.py" args="update,1">
				<label>32001</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos1),update) + Skin.HasSetting(aeon.ctx.update) + [Window.IsActive(videos) | Window.IsActive(music) | Window.IsActive(home)]</visible>
			</item>
			<item library="context.py" args="clean,1">
				<label>32002</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos1),clean) + Skin.HasSetting(aeon.ctx.clean) + [Window.IsActive(videos) | Window.IsActive(music) | Window.IsActive(home)]</visible>
			</item>
			<item library="context.py" args="shot,1">
				<label>32003</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos1),shot) + !Skin.HasSetting(aeon.ctx.noshot)</visible>
			</item>
			<item library="context.py" args="refresh,2">
				<label>32000</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos2),refresh) + Skin.HasSetting(aeon.ctx.refresh) + !ListItem.IsParentFolder + Integer.IsGreater(ListItem.DBID,0) + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,musicvideo)]</visible>
			</item>
			<item library="context.py" args="update,2">
				<label>32001</label>
				<visible>[String.IsEqual(Skin.String(aeon.ctx.pos2),update) | String.IsEmpty(Skin.String(aeon.ctx.pos1))] + Skin.HasSetting(aeon.ctx.update) + [Window.IsActive(videos) | Window.IsActive(music) | Window.IsActive(home)]</visible>
			</item>
			<item library="context.py" args="clean,2">
				<label>32002</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos2),clean) + Skin.HasSetting(aeon.ctx.clean) + [Window.IsActive(videos) | Window.IsActive(music) | Window.IsActive(home)]</visible>
			</item>
			<item library="context.py" args="shot,2">
				<label>32003</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos2),shot) + !Skin.HasSetting(aeon.ctx.noshot)</visible>
			</item>
			<item library="context.py" args="refresh,3">
				<label>32000</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos3),refresh) + Skin.HasSetting(aeon.ctx.refresh) + !ListItem.IsParentFolder + Integer.IsGreater(ListItem.DBID,0) + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,musicvideo)]</visible>
			</item>
			<item library="context.py" args="update,3">
				<label>32001</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos3),update) + Skin.HasSetting(aeon.ctx.update) + [Window.IsActive(videos) | Window.IsActive(music) | Window.IsActive(home)]</visible>
			</item>
			<item library="context.py" args="clean,3">
				<label>32002</label>
				<visible>[String.IsEqual(Skin.String(aeon.ctx.pos3),clean) | String.IsEmpty(Skin.String(aeon.ctx.pos1))] + Skin.HasSetting(aeon.ctx.clean) + [Window.IsActive(videos) | Window.IsActive(music) | Window.IsActive(home)]</visible>
			</item>
			<item library="context.py" args="shot,3">
				<label>32003</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos3),shot) + !Skin.HasSetting(aeon.ctx.noshot)</visible>
			</item>
			<item library="context.py" args="refresh,4">
				<label>32000</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos4),refresh) + Skin.HasSetting(aeon.ctx.refresh) + !ListItem.IsParentFolder + Integer.IsGreater(ListItem.DBID,0) + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,musicvideo)]</visible>
			</item>
			<item library="context.py" args="update,4">
				<label>32001</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos4),update) + Skin.HasSetting(aeon.ctx.update) + [Window.IsActive(videos) | Window.IsActive(music) | Window.IsActive(home)]</visible>
			</item>
			<item library="context.py" args="clean,4">
				<label>32002</label>
				<visible>String.IsEqual(Skin.String(aeon.ctx.pos4),clean) + Skin.HasSetting(aeon.ctx.clean) + [Window.IsActive(videos) | Window.IsActive(music) | Window.IsActive(home)]</visible>
			</item>
			<item library="context.py" args="shot,4">
				<label>32003</label>
				<visible>[String.IsEqual(Skin.String(aeon.ctx.pos4),shot) | String.IsEmpty(Skin.String(aeon.ctx.pos1))] + !Skin.HasSetting(aeon.ctx.noshot)</visible>
			</item>
		</menu>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Library counts for the Aeon Fuse skin.</summary>
		<description lang="en_GB">Also publishes every rating (IMDb, TMDb, Rotten Tomatoes, Trakt) of the focused item as Home properties (aeon.r.*), because Kodi lists only carry the default rating. Reads the size of the video and music libraries through JSON-RPC and publishes it as Home window properties (aeon.count.movies, aeon.count.tvshows, aeon.count.episodes, aeon.count.artists, aeon.count.albums, aeon.count.songs) for the Aeon Fuse skin. It refreshes on start-up and after every library scan or clean. It does nothing under other skins.</description>
		<platform>all</platform>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
		</assets>
		<license>GPL-2.0-or-later</license>
	</extension>
</addon>
